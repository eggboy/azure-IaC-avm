# Multi-auth MCP server configuration. Every value is optional — the server
# falls back to the hardcoded defaults in src/config.py when a variable is
# unset. The defaults are intentionally permissive for local development; tune
# them before exposing the server outside a trusted VNet.

# --- Listener ---
PORT=8080
LOG_LEVEL=INFO

# --- API-key auth (Bearer token in the API_KEYS set) ---
# Comma-separated list. Default in src/config.py is the dev placeholder
# "devkey123". Set to an empty string to disable API-key auth entirely.
API_KEYS=devkey123

# --- CORS / Origin allow-list (also enforced for /noauth/mcp) ---
ALLOWED_ORIGINS=http://localhost:6274,http://localhost:5173,https://ai.azure.com

# --- Entra ID JWT auth ---
# The server validates JWT bearer tokens against this tenant's JWKS endpoint
# and requires the audience claim to match MCP_APP_ID.
TENANT_ID=
RESOURCE_ID=api://multi-auth-mcp
MCP_AUDIENCE=api://multi-auth-mcp/.default
MCP_APP_ID=

# --- Optional fine-grained authorization ---
# Space-separated scope/role names that must ALL be present on the token.
REQUIRED_SCOPES=
REQUIRED_ROLES=
# Comma-separated client IDs (appid/azp claim) that classify the caller as an
# "agent_identity" or "project_managed_identity" subtype in /authz responses.
ALLOWED_AGENT_IDS=
ALLOWED_PROJECT_MIS=

# --- Container Apps overrides (auto-populated by ACA, no need to set) ---
# CONTAINER_APP_NAME=
# CONTAINER_APP_ENV_DNS_SUFFIX=
